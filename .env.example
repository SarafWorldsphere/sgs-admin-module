# Frontend environment variables (copy to .env.local for local dev, .env.production for EC2)

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# Academic Setup: server-only planner API base. Never put credentials in this URL.
SYLLABUS_PLANNER_API_URL=http://127.0.0.1:8010/api/v1
# Optional local development stand-in; disabled for normal/production use.
SYLLABUS_PLANNER_DEV_AUTH=false
